@startuml
top to bottom direction

[*] --> INIT

state INIT {
    init_entry: Init GPIO, ADC, PWM\nInit Bluetooth\nInitial battery check
    init_run: Transition to IDLE if all success\nElse transition to ERROR
}
INIT --> IDLE : Init success  
INIT --> ERROR : ADC/LED/BLE init failure

state IDLE {
    idle_entry: Start idle timer\nEnable button interrupts  
    idle_run: Wait for events:\n- BATTERY_TIMER\n- MEASURE event  
}
IDLE --> BATTERY : Battery timer event  
IDLE --> MEASURE : Button pressed (MEASURE event)  
IDLE --> ERROR : Error detected  

state BATTERY {
    battery_entry: Setup ADC for battery\nLog battery read attempt  
    battery_run: Measure battery voltage\nSend battery % via BLE  
}
BATTERY --> IDLE : Battery read complete  
BATTERY --> ERROR : ADC or BLE failure  

state MEASURE {
    measure_entry: Setup ECG & Temp sensors\nCheck readiness  
    measure_run: Sample ECG (30s)\nCompute BPM\nRead temperature\nSend via BLE  
}
MEASURE --> IDLE : Measurement complete  
MEASURE --> ERROR : ADC/Temp/BLE error 
MEASURE --> ERROR : Button pressed (MEASURE event)  

state ERROR {
    error_entry: Stop timers & PWM\nLog error\nRaise error flag  
    error_run: Send error flags via BLE\nWait for reset  
}
ERROR --> IDLE : Reset button pressed
ERROR --> [*]

@enduml
