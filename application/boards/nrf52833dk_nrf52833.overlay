/ {
        zephyr,user {
            io-channels = <&adc 0>, <&adc 1>;
                };
	aliases {
        heartbeat = &led0;  // this corresponds to LED1 on the board
        // batterylevel = &led1;  // this corresponds to LED2 on the board
        avgheartrate = &led2;  // this corresponds to LED3 on the board
        erroronly = &led3;  // this corresponds to LED4 on the board

        hrmeasure = &button0;
        clearmeasure = &button1;
        resetdevice = &button2;

        vadc = &vadc;
        diffadc = &diffadc;

        pwm1 = &pwmch1;
	};

    pwm {
        compatible = "pwm-leds";
        // Battery level LED
        pwmch1: pwm_1 {
            pwms = < &pwm0 0 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
            label = "PWM_CH1";
        };
    };
};

&adc {
    #address-cells = <1>;
    #size-cells = <0>;

    vadc: channel@0 {
        reg = <0>;
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,gain = "ADC_GAIN_1_5";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN0>; // P0.02
        zephyr,resolution = <12>;
    };

    diffadc: channel@1 {
        reg = <1>;
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,gain = "ADC_GAIN_1_5";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN1>;  // P0.03
        zephyr,input-negative = <NRF_SAADC_AIN2>;  // P0.04
        zephyr,resolution = <12>;
    };

    status = "okay";
};

&pwm0 {
    compatible = "nordic,nrf-pwm";
    reg = <0x4001c000 0x1000>;
    interrupts = <28 NRF_DEFAULT_IRQ_PRIORITY>;
    status = "okay";
    #pwm-cells = <3>;
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};
&pinctrl {
    compatible = "nordic,nrf-pinctrl";
    status = "okay";
    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 14)>; // P0.14, channel 0
            nordic,invert;
        };
    };
    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 14)>; // P0.14, channel 0
            low-power-enable;
        };
    };
}; 

/* I2C Pin Mapping
SCK: P0.27
SDA: P0.26
*/
&i2c0 {
    status = "okay";

    mcp9808@18 {
        compatible = "jedec,jc-42.4-temp";
        reg = <0x18>;
        label = "MCP9808";
        status = "okay";
    };
};
